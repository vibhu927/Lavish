# Public site URL — used for sitemap.xml, robots.txt and og tags.
NEXT_PUBLIC_SITE_URL="https://leaforganic.com"

# Signs the admin session cookie. REQUIRED everywhere (16+ chars).
# Generate one:  openssl rand -base64 32
# On Vercel: dashboard → your project → Settings → Environment Variables →
# add AUTH_SECRET, then redeploy. Without it every admin page crashes.
AUTH_SECRET="replace-me-with-a-long-random-string"

# How publishing works in this project (portfolio-style, no extra services):
# content JSON (data/) and photos (uploads/) are COMMITTED to git.
#   1. Edit on localhost:3000/admin (saves to data/ + uploads/ on your laptop)
#   2. git add data uploads && git commit && git push
#   3. Vercel rebuilds — the live site shows the new content.
# NEVER edit on the live URL: the live filesystem is read-only, saves there
# fail with an honest error, and anything that looks saved vanishes anyway.

# REQUIRED on Vercel: the build seeds the admin login from these (data/
# carries no adminUser.json — it is gitignored so the password hash never
# lands in the repo). Set both in Vercel env vars, then redeploy.
# ADMIN_EMAIL="you@example.com"
# ADMIN_PASSWORD="a-strong-password"

# Local dev: `npm run admin -- you@example.com 'a-password'` does the same.
# `npm run seed` re-adds starter content but never overwrites existing rows.

# Optional. Defaults to ./data and ./uploads next to the app.
# Only needed on a VPS with absolute persistent paths (see README + /api/health).
# DATA_DIR="/srv/leaf-organic/data"
# UPLOAD_DIR="/srv/leaf-organic/uploads"
