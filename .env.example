# Public site URL — used for sitemap.xml, robots.txt and og tags.
NEXT_PUBLIC_SITE_URL="https://leaforganic.com"

# Signs the admin session cookie. REQUIRED in production (16+ chars).
# Generate one:  openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-long-random-string"

# Optional. Defaults to ./data and ./uploads next to the app.
# DATA_DIR="/var/lib/leaf-organic/data"
# UPLOAD_DIR="/var/lib/leaf-organic/uploads"

# Optional: credentials for `npm run seed` and `npm run admin`.
# These scripts DO read this file (bare node/tsx does not load .env by itself).
# ADMIN_EMAIL="you@example.com"
# ADMIN_PASSWORD="a-strong-password"
