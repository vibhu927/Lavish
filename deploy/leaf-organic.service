[Unit]
Description=Leaf Organic (Next.js)
After=network.target

[Service]
Type=simple
User=leaf
Group=leaf
WorkingDirectory=/srv/leaf-organic

# Keep secrets out of the unit file.
EnvironmentFile=/srv/leaf-organic/.env

ExecStart=/usr/bin/node node_modules/next/dist/bin/next start -p 3000
Restart=always
RestartSec=5

# data/ and uploads/ are the live database and media store.
# They live inside the app dir and are NOT in git, so a `git pull`
# deploy will not touch them.
#
# The whole app dir is writable to the service (not just data/ + uploads/)
# because the app must be able to CREATE data/ + uploads/ on first boot —
# with ProtectSystem=strict a missing data/ dir made every save fail with
# EROFS and the admin fell back to old content on refresh. Pre-create the
# dirs on deploy as well:
#   sudo mkdir -p /srv/leaf-organic/data /srv/leaf-organic/uploads
#   sudo chown -R leaf:leaf /srv/leaf-organic/data /srv/leaf-organic/uploads
ReadWritePaths=/srv/leaf-organic /srv/leaf-organic/data /srv/leaf-organic/uploads

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=leaf-organic

[Install]
WantedBy=multi-user.target
