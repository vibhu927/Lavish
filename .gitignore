# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files - keep the real ones out, but commit the template
.env*
!.env.example

# vercel
.vercel

# JSON data layer - mutable content, never deploy-clobbered.
# Back this up (scripts/backup.mjs); it is the live database.
/data/*.json

# uploaded media - the live media store, never in git
/uploads/*
!/uploads/.gitkeep

# local backups from scripts/backup.mjs
/backups/

# typescript
*.tsbuildinfo
next-env.d.ts
