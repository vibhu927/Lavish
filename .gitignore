# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files - keep the real ones out, but commit the template
.env*
!.env.example

# vercel
.vercel

# Content database IS tracked in git (publish-by-push, portfolio-style):
# edit on localhost, commit data/ + uploads/, push — Vercel rebuilds live.
# NEVER commit the admin login: it is seeded from ADMIN_EMAIL/ADMIN_PASSWORD
# at build time (see .env.example). Also ignore write probes + crash tmp.
data/adminUser.json
data/*.tmp
data/.write-test.*
uploads/.write-test.*

# local backups from scripts/backup.mjs
/backups/

# typescript
*.tsbuildinfo
next-env.d.ts
